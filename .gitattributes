# Force Unix line endings for all text files
* text=auto eol=lf
# Specific rules for shell scripts and python files
*.sh text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.md text eol=lf
# Binary files (do not convert line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.whl binary
*.so binary
*.pyd binary
*
